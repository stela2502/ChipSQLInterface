#!/bin/bash

# Path to your Singularity image
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
VERSION=1.1
SINGULARITY_IMAGE="$SCRIPT_DIR/../ChipSQLInterface_v${VERSION}.sif"

# Check if a command was provided
if [ "$#" -lt 1 ]; then
  echo "Usage: ChipSQLInterface /path/to/database.db"
  echo "Will create the database and start the web server"
  exit 1
fi



# Run the command inside the Singularity image
apptainer exec "$SINGULARITY_IMAGE" /usr/local/bin/GeneStatsServer --db-file $@
